ERAPOWER_URL=https://c2892-erapower.pentana.cloud/base/templates/vIndependent.htm
ERAPOWER_BROWSER_CHANNEL=chrome
ERAPOWER_TIMEZONE=Australia/Melbourne
# Live window opened by browser:open. Clear only to use exported-state mode.
ERAPOWER_CDP_URL=http://127.0.0.1:9223
# Required for unattended session:test. Choose an element visible ONLY after login.
ERAPOWER_READY_SELECTOR="#AppUser:not(:empty)"
# Optional selector of the iframe containing the authenticated element.
ERAPOWER_READY_FRAME=name:applicationHeader

# Backend operator session; never use a Supabase service-role key here.
GOODSHOWROOM_API_URL=http://localhost:4000/api/
GOODSHOWROOM_WEB_URL=http://localhost:3000
GOODSHOWROOM_ORGANISATION_ID=
GOODSHOWROOM_SITE_ID=
GOODSHOWROOM_ACCESS_TOKEN=
GOODSHOWROOM_SYNC_INTERVAL_SECONDS=300
